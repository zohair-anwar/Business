# =========================================================
# Off Watch Wellness — environment variables
# Copy to ".env" for local use, or set these in your Vercel
# project (Settings → Environment Variables). All are optional;
# set the group(s) you want to use.
# =========================================================

# ---- Supabase: stores waitlist signups in a table ----
# Create a project at https://supabase.com, run db/supabase-schema.sql
# in the SQL editor, then copy these from Settings → API.
# Use the SERVICE ROLE key (server-side only — never expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Resend: emails you when someone joins ----
# Create a key at https://resend.com. WAITLIST_TO can be a
# comma-separated list. WAITLIST_FROM must be on a domain you've
# verified in Resend (or omit to use Resend's onboarding sender).
RESEND_API_KEY=
WAITLIST_TO=hello@offwatchwellness.ca
WAITLIST_FROM=Off Watch Wellness <waitlist@offwatchwellness.ca>

# ---- Local server.js only ----
# Set to 1 to skip writing data/waitlist.json (e.g. when relying
# solely on Supabase). Leave unset for normal local development.
# DISABLE_FILE_STORE=1
